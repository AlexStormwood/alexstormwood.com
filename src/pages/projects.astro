---
import ProjectDirectory from '../components/ProjectDirectory';
import Layout from '../layouts/BlogPost.astro';
import { getProjects } from '../utils/projects';
import "../styles/Projects.css";
const projectMap = await getProjects();
const projects = Object.values(projectMap);
---

<Layout
	title="Projects"
	description="Projects by Alex Stormwood and BigfootDS, with the public work and evidence behind each one."
	pubDate={new Date('December 15 2024')}
	heroImage="/projects/Header.png"
>
	
<div class="projects-page" id="projectsPage">
	<section class="projects-page__intro">
		<p class="projects-eyebrow">Portfolio directory</p>
		<p class="projects-lead">Public work by me and BigfootDS: games, web apps, developer tooling, and the systems around making them. Every card names the context and links to the best available evidence.</p>
	</section>

	<ProjectDirectory projects={projects} client:load />

</div>

</Layout>
<style>
.projects-eyebrow {
	margin-bottom: 0.5rem;
	color: var(--accent);
	font-size: 0.85rem;
	font-weight: 700;
	letter-spacing: 0.08em;
	text-transform: uppercase;
}

.projects-lead {
	max-width: 44rem;
	font-size: 1.2rem;
}
</style>
