---
import ProjectCard from '../components/ProjectCard';
import Layout from '../layouts/BlogPost.astro';
import { getProjects } from '../utils/projects';
import "../styles/ArticleContent.css";
import "../styles/Projects.css";
const projectMeta = await getProjects();
---

<Layout
	title="Projects"
	description="See what Alex has been making!"
	pubDate={new Date('December 15 2024')}
	heroImage="/projects/Header.png"
>
	
<div class="articleContent" id="projectsPage">
	<section>
		<p class="projects-eyebrow">Selected work</p>
		<p class="projects-lead">Projects spanning web development, developer tooling, games, and the systems that help people make things.</p>
	</section>

	<section>
		<h2>In progress</h2>
		<p>Ongoing work that may still be private or in development through BigfootDS.</p>
		<ul>
			<li>Patron Simulator (real-time strategy game)</li>
			<li>The Bestest Beehive (open-world cosy crafting game)</li>
		</ul>
	</section>

	<section>
		<h2>Open source</h2>
		<p>Public projects that are open to use, inspection, and contribution.</p>
		<div class="projectCardContainer">
		<ProjectCard projectObj={projectMeta["sourcepool"]} />
		<ProjectCard projectObj={projectMeta["supercamo"]} />
		<ProjectCard projectObj={projectMeta["npmcompliancehelper"]} />
		<ProjectCard projectObj={projectMeta["commitswithintime"]} />
		<ProjectCard projectObj={projectMeta["unityautomatedsemver"]} />
		<ProjectCard projectObj={projectMeta["unityupmsemver"]} />
		
		</div>

	</section>

	<section>
		<h2>Completed &amp; archived</h2>
		<p>Games, prototypes, and client work that remain part of the story.</p>
		<div class="projectCardContainer">
		<ProjectCard projectObj={projectMeta["ppvr"]} />
		<ProjectCard projectObj={projectMeta["ggj2020"]} />
		<ProjectCard projectObj={projectMeta["ggj2019"]} />
		<ProjectCard projectObj={projectMeta["aitvrtour"]} />
		<ProjectCard projectObj={projectMeta["scotsyukivr"]} />
		</div>
	</section>








</div>

</Layout>
<style>
.projects-eyebrow {
	margin-bottom: 0.5rem;
	color: var(--accent);
	font-size: 0.85rem;
	font-weight: 700;
	letter-spacing: 0.08em;
	text-transform: uppercase;
}

.projects-lead {
	max-width: 44rem;
	font-size: 1.2rem;
}
</style>
