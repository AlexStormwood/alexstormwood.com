---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { getVisiblePosts } from '../../utils/blog';

const posts = await getVisiblePosts();
const featuredPosts = posts.filter((post) => post.data.featured);
const journalPosts = posts.filter((post) => post.data.tags.includes('journal'));
const technicalPosts = posts.filter(
	(post) => post.data.tags.includes('technical') && !post.data.featured,
);
const personalPosts = posts.filter(
	(post) => post.data.tags.includes('personal') && !post.data.featured,
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Articles" description={SITE_DESCRIPTION} />
		<style>
			main { width: min(1100px, calc(100% - 2rem)); }
			.intro { max-width: 48rem; margin-bottom: 3.5rem; }
			.eyebrow { margin: 0 0 0.75rem; color: var(--accent); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
			.intro h1 { font-size: clamp(2.5rem, 7vw, 4.6rem); }
			.lead { max-width: 42rem; font-size: 1.2rem; }
			.topic-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
			.topic-links a { display: inline-block; padding: 0.45rem 0.85rem; border: 1px solid light-dark(var(--theme-300), var(--theme-600)); border-radius: 999px; color: inherit; text-decoration: none; }
			.topic-links a:hover, .topic-links a:focus-visible { border-color: var(--accent); color: var(--accent); }
			.writing-section { margin-top: 4.5rem; }
			.section-heading { max-width: 44rem; margin-bottom: 1.5rem; }
			.section-heading h2 { margin-bottom: 0.25rem; }
			.section-heading p { margin: 0; color: var(--gray); }
			.article-stack { display: grid; gap: 1.25rem; }
			.article-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
			@media (max-width: 720px) { .writing-section { margin-top: 3.5rem; } .article-grid { grid-template-columns: 1fr; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="intro">
				<p class="eyebrow">Writing</p>
				<h1>Notes from building, teaching, and exploring.</h1>
				<p class="lead">Technical explainers, practical software notes, and the occasional detailed travel journal.</p>
				<nav aria-label="Browse articles by focus">
					<ul class="topic-links">
						<li><a href="#technical">Software &amp; games</a></li>
						<li><a href="#journal">Travel journal</a></li>
						<li><a href="#personal">Personal notes</a></li>
					</ul>
				</nav>
			</header>

			{featuredPosts.length > 0 && (
				<section class="writing-section" aria-labelledby="featured-heading">
					<div class="section-heading">
						<h2 id="featured-heading">Start here</h2>
						<p>Selected technical writing on the systems and practices behind software projects.</p>
					</div>
					<div class="article-stack">
						{featuredPosts.map((post) => <ArticleCard post={post} featured />)}
					</div>
				</section>
			)}

			{technicalPosts.length > 0 && (
				<section class="writing-section" id="technical" aria-labelledby="technical-heading">
					<div class="section-heading">
						<h2 id="technical-heading">Software &amp; games</h2>
						<p>Questions, experiments, and practical guidance from development work.</p>
					</div>
					<div class="article-grid">
						{technicalPosts.map((post) => <ArticleCard post={post} />)}
					</div>
				</section>
			)}

			{journalPosts.length > 0 && (
				<section class="writing-section" id="journal" aria-labelledby="journal-heading">
					<div class="section-heading">
						<h2 id="journal-heading">Travel journal</h2>
						<p>Long-form travel writing, including the six-part 2025 Japan trip series.</p>
					</div>
					<div class="article-grid">
						{journalPosts.map((post) => <ArticleCard post={post} />)}
					</div>
				</section>
			)}

			{personalPosts.length > 0 && (
				<section class="writing-section" id="personal" aria-labelledby="personal-heading">
					<div class="section-heading">
						<h2 id="personal-heading">Personal notes</h2>
						<p>Context and stories that sit alongside the work.</p>
					</div>
					<div class="article-grid">
						{personalPosts.map((post) => <ArticleCard post={post} />)}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
