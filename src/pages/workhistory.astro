---
import Layout from '../layouts/BlogPost.astro';
import { workHistoryEntries } from '../data/work-history';
import '../styles/WorkHistory.css';
---

<Layout
	title="Employment History"
	description="Learn about Alex's past and current workplaces."
	pubDate={new Date('May 15 2025')}
>
	<div id="employmenthistory-page">
		<p>At the time of this page&apos;s last update (May 2025), I work full-time at Coder Academy within NextEd. I also, slowly, work for myself at BigfootDS - making video games and open-source tools.</p>

		<ol class="work-timeline">
			{workHistoryEntries.map((entry) => (
				<li class="work-timeline__entry">
					<p class="work-timeline__date">{entry.dateLabel}</p>
					<article class="work-timeline__card">
						{entry.image && (
							<img
								class="work-timeline__image"
								src={entry.image.src}
								alt={entry.image.alt}
								loading="lazy"
								decoding="async"
								data-lightbox
							/>
						)}
						<h2>{entry.title}</h2>
						<p>{entry.description}</p>
						{entry.url && <a href={entry.url} target="_blank" rel="noreferrer">Visit organisation <span aria-hidden="true">↗</span></a>}
						{entry.roles && (
							<ol class="work-timeline__roles">
								{entry.roles.map((role) => (
									<li>
										<h3>{role.title}</h3>
										<p>{role.description}</p>
									</li>
								))}
							</ol>
						)}
					</article>
				</li>
			))}
		</ol>
	</div>
</Layout>
