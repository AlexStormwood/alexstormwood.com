
---

const { title, description, heroImage, pubDate, updatedDate } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(heroImage ?? '/website-ogimage-default.png', Astro.site);
---

<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": canonicalURL.href
	},
	"headline": title,
	"image": [
		imageURL.href
	 ],
	"datePublished": pubDate,
	"dateModified": updatedDate ?? pubDate,
	"description": description,
	"author": [
		  {
		  "@type": "Person",
		  "name": "Alex Stormwood",
		  "url": "https://alexstormwood.com/about/",
		  "sameAs": [
			  "https://www.linkedin.com/in/alexstormwood/",
			  "https://github.com/AlexStormwood",
			  "https://bsky.app/profile/alexstormwood.com"
		  ]
		  }
	  ]
  })}>
	
</script>
